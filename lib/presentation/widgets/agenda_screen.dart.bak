import 'dart:math';
import 'package:drift/drift.dart' hide Column;
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:intl/intl.dart';
import '../../data/database/app_database.dart';
import '../../providers/database_providers.dart';
import '../../providers/settings_provider.dart';
import '../../utils/app_localizations.dart';

// ────────────────────────────────────────────────────────────────────────────
// Data model for an agenda entry
// ────────────────────────────────────────────────────────────────────────────
class AgendaEntry {
  final int orderProductId;
  final int orderId;
  final String orderCode;
  final String productName;
  final String? customerName;
  final DateTime start;
  final DateTime end;
  final int? waiterId;
  final String? waiterName;
  final String state;
  final Color color;

  AgendaEntry({
    required this.orderProductId,
    required this.orderId,
    required this.orderCode,
    required this.productName,
    this.customerName,
    required this.start,
    required this.end,
    this.waiterId,
    this.waiterName,
    required this.state,
    required this.color,
  });

  Duration get duration => end.difference(start);
}

// ────────────────────────────────────────────────────────────────────────────
// Provider: load agenda entries for a given date
// ────────────────────────────────────────────────────────────────────────────
final agendaEntriesProvider =
    FutureProvider.family<List<AgendaEntry>, DateTime>((ref, date) async {
  final db = ref.watch(databaseProvider);

  final dayStart = DateTime(date.year, date.month, date.day);
  final dayEnd = dayStart.add(const Duration(days: 1));

  final orderProducts = await (db.select(db.orderProducts)
        ..where((t) =>
            t.planStartAt.isNotNull() &
            t.planStartAt.isBiggerOrEqualValue(dayStart) &
            t.planStartAt.isSmallerThanValue(dayEnd)))
      .get();

  final entries = <AgendaEntry>[];
  for (final op in orderProducts) {
    if (op.planStartAt == null || op.planEndAt == null) continue;

    final product = await (db.select(db.products)
          ..where((t) => t.id.equals(op.productId)))
        .getSingleOrNull();

    final order = await (db.select(db.orders)
          ..where((t) => t.id.equals(op.orderId)))
        .getSingleOrNull();

    String? customerName;
    if (order?.clientId != null) {
      final customer = await (db.select(db.customers)
            ..where((t) => t.id.equals(order!.clientId!)))
          .getSingleOrNull();
      if (customer != null) {
        customerName = '${customer.firstName} ${customer.lastName}'.trim();
      }
    }

    String? waiterName;
    if (op.planWaiterId != null) {
      final waiter = await (db.select(db.waiters)
            ..where((t) => t.id.equals(op.planWaiterId!)))
          .getSingleOrNull();
      if (waiter != null) {
        waiterName = '${waiter.firstName} ${waiter.lastName ?? ''}'.trim();
      }
    }

    Color color;
    switch (op.state) {
      case 'COMPLETED':
        color = Colors.green.shade300;
        break;
      case 'PREPARING':
        color = Colors.orange.shade300;
        break;
      case 'CANCELED':
        color = Colors.red.shade300;
        break;
      default:
        color = Colors.blue.shade300;
    }

    entries.add(AgendaEntry(
      orderProductId: op.id,
      orderId: op.orderId,
      orderCode: order?.code ?? '#${op.orderId}',
      productName: product?.name ?? 'Product #${op.productId}',
      customerName: customerName,
      start: op.planStartAt!,
      end: op.planEndAt!,
      waiterId: op.planWaiterId,
      waiterName: waiterName,
      state: op.state,
      color: color,
    ));
  }

  entries.sort((a, b) => a.start.compareTo(b.start));
  return entries;
});

// Provider: all waiters (for column headers)
final allWaitersProvider = FutureProvider<List<Waiter>>((ref) async {
  final db = ref.watch(databaseProvider);
  return db.select(db.waiters).get();
});

// ────────────────────────────────────────────────────────────────────────────
// Agenda Screen Widget
// ────────────────────────────────────────────────────────────────────────────
class AgendaScreen extends ConsumerStatefulWidget {
  const AgendaScreen({super.key});

  @override
  ConsumerState<AgendaScreen> createState() => _AgendaScreenState();
}

class _AgendaScreenState extends ConsumerState<AgendaScreen> {
  DateTime _selectedDate = DateTime.now();

  static const int _startHour = 7;
  static const int _endHour = 23;
  static const double _hourHeight = 80.0;
  static const double _headerHeight = 56.0;
  static const double _timeColWidth = 60.0;
  static const double _colWidth = 200.0;

  final ScrollController _vScrollCtrl = ScrollController();
  final ScrollController _hScrollCtrl = ScrollController();
  bool _scrolledToNow = false;

  // Drag-and-drop state
  final GlobalKey _timelineKey = GlobalKey();
  List<int?> _waiterIds = [];
  double _cachedColWidth = _colWidth;

  void _scrollToCurrentHour() {
    if (_vScrollCtrl.hasClients && !_scrolledToNow) {
      final currentHour = TimeOfDay.now().hour;
      final offset =
          (currentHour - _startHour).clamp(0, _endHour - _startHour) *
              _hourHeight;
      _vScrollCtrl.animateTo(offset,
          duration: const Duration(milliseconds: 300), curve: Curves.easeOut);
      _scrolledToNow = true;
    }
  }

  @override
  void dispose() {
    _vScrollCtrl.dispose();
    _hScrollCtrl.dispose();
    super.dispose();
  }

  void _previousDay() => setState(() {
        _selectedDate = _selectedDate.subtract(const Duration(days: 1));
        _scrolledToNow = false;
      });

  void _nextDay() => setState(() {
        _selectedDate = _selectedDate.add(const Duration(days: 1));
        _scrolledToNow = false;
      });

  @override
  Widget build(BuildContext context) {
    final l10n = AppLocalizations.of(context)!;
    final theme = Theme.of(context);
    final isDark = theme.brightness == Brightness.dark;
    final entriesAsync = ref.watch(agendaEntriesProvider(_selectedDate));
    final waitersAsync = ref.watch(allWaitersProvider);
    final timeStep = ref.watch(settingsProvider).agendaTimeStep;

    entriesAsync.whenData((_) {
      WidgetsBinding.instance
          .addPostFrameCallback((_) => _scrollToCurrentHour());
    });

    return Scaffold(
      appBar: AppBar(
        title: Text(l10n.translate('agenda')),
        actions: [
          // Time-step selector
          PopupMenuButton<int>(
            icon: const Icon(Icons.grid_on),
            tooltip: 'Time step',
            initialValue: timeStep,
            onSelected: (minutes) =>
                ref.read(settingsProvider.notifier).setAgendaTimeStep(minutes),
            itemBuilder: (_) => const [
              PopupMenuItem(value: 60, child: Text('1 Hour')),
              PopupMenuItem(value: 30, child: Text('30 Minutes')),
              PopupMenuItem(value: 15, child: Text('15 Minutes')),
            ],
          ),
          IconButton(
            icon: const Icon(Icons.today),
            tooltip: l10n.translate('today'),
            onPressed: () => setState(() {
              _selectedDate = DateTime.now();
              _scrolledToNow = false;
            }),
          ),
        ],
      ),
      body: Column(
        children: [
          // ── Date navigation bar ──────────────────────────────────────────
          Container(
            color: isDark
                ? theme.colorScheme.surface
                : theme.colorScheme.surfaceContainerHighest,
            padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 6),
            child: Row(
              children: [
                IconButton(
                    icon: const Icon(Icons.chevron_left),
                    onPressed: _previousDay),
                Expanded(
                  child: GestureDetector(
                    onTap: () => _pickDate(context),
                    child: Text(
                      DateFormat('EEEE, MMMM d, yyyy').format(_selectedDate),
                      textAlign: TextAlign.center,
                      style: theme.textTheme.titleMedium
                          ?.copyWith(fontWeight: FontWeight.bold),
                    ),
                  ),
                ),
                IconButton(
                    icon: const Icon(Icons.chevron_right),
                    onPressed: _nextDay),
              ],
            ),
          ),
          // ── Main timeline ────────────────────────────────────────────────
          Expanded(
            child: entriesAsync.when(
              loading: () =>
                  const Center(child: CircularProgressIndicator()),
              error: (e, _) => Center(child: Text('Error: $e')),
              data: (entries) => waitersAsync.when(
                loading: () =>
                    const Center(child: CircularProgressIndicator()),
                error: (e, _) =>
                    _buildTimeline(context, entries, [], timeStep),
                data: (waiters) =>
                    _buildTimeline(context, entries, waiters, timeStep),
              ),
            ),
          ),
        ],
      ),
    );
  }

  Future<void> _pickDate(BuildContext context) async {
    final picked = await showDatePicker(
      context: context,
      initialDate: _selectedDate,
      firstDate: DateTime(2020),
      lastDate: DateTime(2030),
    );
    if (picked != null) {
      setState(() {
        _selectedDate = picked;
        _scrolledToNow = false;
      });
    }
  }

  Widget _buildTimeline(BuildContext context, List<AgendaEntry> entries,
      List<Waiter> allWaiters, int timeStep) {
    final Map<int?, String> waiterLabels = {null: 'Unassigned'};
    for (final w in allWaiters) {
      waiterLabels[w.id] = '${w.firstName} ${w.lastName ?? ''}'.trim();
    }
    for (final e in entries) {
      if (e.waiterId != null && !waiterLabels.containsKey(e.waiterId)) {
        waiterLabels[e.waiterId] = e.waiterName ?? 'Waiter ${e.waiterId}';
      }
    }

    final waiterIds = waiterLabels.keys.toList();
    waiterIds.sort((a, b) {
      if (a == null) return -1;
      if (b == null) return 1;
      return a.compareTo(b);
    });

    final Map<int?, List<AgendaEntry>> byWaiter = {
      for (final id in waiterIds) id: []
    };
    for (final e in entries) {
      byWaiter[e.waiterId]!.add(e);
    }

    final theme = Theme.of(context);
    final isDark = theme.brightness == Brightness.dark;
    final totalHours = _endHour - _startHour;
    final double totalHeight = totalHours * _hourHeight;
    final double availableWidth =
        MediaQuery.of(context).size.width - _timeColWidth;
    final double colWidth = waiterIds.length <= 1
        ? availableWidth
        : max(_colWidth, availableWidth / waiterIds.length);
    final double totalTimelineWidth =
        _timeColWidth + colWidth * waiterIds.length;

    // Cache for use in drag callbacks
    _waiterIds = waiterIds;
    _cachedColWidth = colWidth;

    return Scrollbar(
      controller: _vScrollCtrl,
      thumbVisibility: true,
      child: SingleChildScrollView(
        controller: _vScrollCtrl,
        child: SizedBox(
          width: double.infinity,
          child: Scrollbar(
            controller: _hScrollCtrl,
            thumbVisibility: true,
            notificationPredicate: (n) => n.depth == 1,
            child: SingleChildScrollView(
              scrollDirection: Axis.horizontal,
              controller: _hScrollCtrl,
              child: SizedBox(
                width: totalTimelineWidth,
                child: Column(
                  children: [
                    // ── Column headers (waiter names) ────────────────────
                    SizedBox(
                      height: _headerHeight,
                      child: Row(
                        children: [
                          SizedBox(
                            width: _timeColWidth,
                            child: Container(
                              color: isDark
                                  ? theme.colorScheme.surface
                                  : theme.colorScheme
                                      .surfaceContainerHighest,
                            ),
                          ),
                          ...waiterIds.map((wId) {
                            final label =
                                waiterLabels[wId] ?? 'Waiter $wId';
                            final entryCount =
                                byWaiter[wId]?.length ?? 0;
                            return Container(
                              width: colWidth,
                              height: _headerHeight,
                              decoration: BoxDecoration(
                                color: isDark
                                    ? theme.colorScheme.surface
                                    : theme.colorScheme
                                        .surfaceContainerHighest,
                                border: Border(
                                  left: BorderSide(
                                      color: theme.dividerColor),
                                  bottom: BorderSide(
                                      color: theme.dividerColor),
                                ),
                              ),
                              alignment: Alignment.center,
                              child: Padding(
                                padding: const EdgeInsets.symmetric(
                                    horizontal: 4),
                                child: Column(
                                  mainAxisAlignment:
                                      MainAxisAlignment.center,
                                  children: [
                                    Text(
                                      label,
                                      style: theme.textTheme.labelMedium
                                          ?.copyWith(
                                              fontWeight:
                                                  FontWeight.bold),
                                      overflow: TextOverflow.ellipsis,
                                      textAlign: TextAlign.center,
                                    ),
                                    if (entryCount > 0)
                                      Text(
                                        '$entryCount booking${entryCount > 1 ? 's' : ''}',
                                        style: theme.textTheme.labelSmall
                                            ?.copyWith(
                                                color: theme
                                                    .colorScheme.primary),
                                      ),
                                  ],
                                ),
                              ),
                            );
                          }),
                        ],
                      ),
                    ),
                    // ── Timeline (drag target) ─────────────────────────
                    DragTarget<AgendaEntry>(
                      onWillAccept: (_) => true,
                      onAcceptWithDetails: (details) =>
                          _onEntryDropped(details, timeStep),
                      builder: (context, candidates, rejected) {
                        return SizedBox(
                          key: _timelineKey,
                          height: totalHeight,
                          child: Stack(
                            children: [
                              _buildHourGrid(context, totalHours,
                                  colWidth * waiterIds.length, timeStep),
                              // Drop-zone highlight
                              if (candidates.isNotEmpty)
                                Positioned.fill(
                                  child: Container(
                                    color: theme.colorScheme.primary
                                        .withValues(alpha: 0.04),
                                  ),
                                ),
                              ...waiterIds.asMap().entries.expand(
                                    (colEntry) {
                                  final colIndex = colEntry.key;
                                  final wId = colEntry.value;
                                  final colEntries =
                                      byWaiter[wId] ?? [];
                                  return colEntries.map(
                                    (e) => _buildEntryBlock(
                                        context, e, colIndex, colWidth),
                                  );
                                },
                              ),
                              _buildCurrentTimeLine(context,
                                  colWidth * waiterIds.length),
                            ],
                          ),
                        );
                      },
                    ),
                  ],
                ),
              ),
            ),
          ),
        ),
      ),
    );
  }

  Widget _buildHourGrid(BuildContext context, int totalHours,
      double totalWidth, int timeStep) {
    final theme = Theme.of(context);
    final isDark = theme.brightness == Brightness.dark;
    final stepsPerHour = 60 ~/ timeStep;

    return Column(
      children: List.generate(totalHours, (i) {
        final hour = _startHour + i;
        return SizedBox(
          height: _hourHeight,
          child: Stack(
            children: [
              Row(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  SizedBox(
                    width: _timeColWidth,
                    child: Padding(
                      padding: const EdgeInsets.only(top: 2, right: 6),
                      child: Text(
                        '${hour.toString().padLeft(2, '0')}:00',
                        textAlign: TextAlign.right,
                        style: theme.textTheme.bodySmall?.copyWith(
                          color: theme.colorScheme.onSurface
                              .withValues(alpha: 0.55),
                        ),
                      ),
                    ),
                  ),
                  Expanded(
                    child: Container(
                      decoration: BoxDecoration(
                        border: Border(
                          top: BorderSide(
                            color: i == 0
                                ? theme.dividerColor
                                : theme.dividerColor
                                    .withValues(alpha: 0.4),
                          ),
                        ),
                        color: isDark
                            ? (i.isEven
                                ? Colors.transparent
                                : theme.colorScheme.surfaceContainerLowest)
                            : (i.isEven
                                ? Colors.transparent
                                : theme.colorScheme.surfaceContainerLowest),
                      ),
                    ),
                  ),
                ],
              ),
              // Sub-step divider lines
              for (int s = 1; s < stepsPerHour; s++)
                Positioned(
                  top: _hourHeight * s / stepsPerHour,
                  left: _timeColWidth,
                  right: 0,
                  child: Container(
                    height: 0.5,
                    color: theme.dividerColor.withValues(alpha: 0.35),
                  ),
                ),
              // Sub-step time labels (only for ≤30-min steps)
              if (timeStep <= 30)
                for (int s = 1; s < stepsPerHour; s++)
                  Positioned(
                    top: _hourHeight * s / stepsPerHour - 8,
                    left: 0,
                    width: _timeColWidth,
                    child: Text(
                      '${hour.toString().padLeft(2, '0')}:${(s * timeStep).toString().padLeft(2, '0')}',
                      textAlign: TextAlign.right,
                      style: theme.textTheme.bodySmall?.copyWith(
                        fontSize: 9,
                        color: theme.colorScheme.onSurface
                            .withValues(alpha: 0.38),
                      ),
                    ),
                  ),
            ],
          ),
        );
      }),
    );
  }

  Widget _buildEntryBlock(BuildContext context, AgendaEntry e, int colIndex,
      double colWidth) {
    final topOffset = _entryTopOffset(e.start);
    final blockHeight =
        max(28.0, _hourHeight * e.duration.inMinutes / 60.0);
    final leftOffset = _timeColWidth + colIndex * colWidth + 2;

    final content = _buildEntryContent(e, blockHeight, colWidth - 4);

    return Positioned(
      top: topOffset,
      left: leftOffset,
      width: colWidth - 4,
      height: blockHeight,
      child: LongPressDraggable<AgendaEntry>(
        data: e,
        delay: const Duration(milliseconds: 350),
        feedback: Material(
          elevation: 8,
          borderRadius: BorderRadius.circular(6),
          child: SizedBox(
            width: colWidth - 4,
            height: blockHeight,
            child: _buildEntryContent(e, blockHeight, colWidth - 4,
                opacity: 0.9),
          ),
        ),
        childWhenDragging: Opacity(
          opacity: 0.3,
          child: content,
        ),
        child: GestureDetector(
          onTap: () => _showEntryDetail(context, e),
          onLongPress: () => _editEntryTime(context, e),
          child: content,
        ),
      ),
    );
  }

  Widget _buildEntryContent(AgendaEntry e, double blockHeight, double width,
      {double opacity = 0.85}) {
    return Container(
      decoration: BoxDecoration(
        color: e.color.withValues(alpha: opacity),
        borderRadius: BorderRadius.circular(6),
        border: Border.all(color: e.color.darken(0.2), width: 1),
        boxShadow: [
          BoxShadow(
              color: Colors.black.withValues(alpha: 0.2),
              blurRadius: 3,
              offset: const Offset(1, 1))
        ],
      ),
      padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 3),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        mainAxisSize: MainAxisSize.min,
        children: [
          Text(
            e.productName,
            style: const TextStyle(
                fontWeight: FontWeight.bold,
                fontSize: 11,
                color: Colors.white),
            maxLines: 1,
            overflow: TextOverflow.ellipsis,
          ),
          if (blockHeight > 38 && e.customerName != null)
            Text(
              e.customerName!,
              style:
                  const TextStyle(fontSize: 10, color: Colors.white70),
              maxLines: 1,
              overflow: TextOverflow.ellipsis,
            ),
          if (blockHeight > 52)
            Text(
              '${DateFormat.Hm().format(e.start)} – ${DateFormat.Hm().format(e.end)}',
              style:
                  const TextStyle(fontSize: 10, color: Colors.white70),
            ),
          if (blockHeight > 68)
            Text(
              e.orderCode,
              style:
                  const TextStyle(fontSize: 9, color: Colors.white60),
              maxLines: 1,
              overflow: TextOverflow.ellipsis,
            ),
        ],
      ),
    );
  }

  double _entryTopOffset(DateTime dt) {
    final minutesFromStart = (dt.hour - _startHour) * 60 + dt.minute;
    return minutesFromStart * _hourHeight / 60.0;
  }

  Widget _buildCurrentTimeLine(BuildContext context, double totalWidth) {
    final now = DateTime.now();
    if (now.hour < _startHour || now.hour >= _endHour) {
      return const SizedBox.shrink();
    }
    if (!_isSameDay(now, _selectedDate)) return const SizedBox.shrink();

    final top = _entryTopOffset(now);
    return Positioned(
      top: top,
      left: _timeColWidth,
      width: totalWidth,
      child: Row(
        children: [
          Container(
              width: 10,
              height: 10,
              decoration: const BoxDecoration(
                  color: Colors.red, shape: BoxShape.circle)),
          Expanded(child: Container(height: 1.5, color: Colors.red)),
        ],
      ),
    );
  }

  bool _isSameDay(DateTime a, DateTime b) =>
      a.year == b.year && a.month == b.month && a.day == b.day;

  // ── Drag-and-drop reschedule ─────────────────────────────────────────────

  Future<void> _onEntryDropped(
      DragTargetDetails<AgendaEntry> details, int timeStep) async {
    final entry = details.data;
    final box =
        _timelineKey.currentContext?.findRenderObject() as RenderBox?;
    if (box == null) return;

    final local = box.globalToLocal(details.offset);

    // Y → snapped start time
    final rawMinutes = local.dy / _hourHeight * 60.0;
    final maxStart =
        (_endHour - _startHour) * 60 - entry.duration.inMinutes;
    final snapped = ((rawMinutes / timeStep).round() * timeStep)
        .clamp(0, maxStart < 0 ? 0 : maxStart)
        .toInt();

    final newHour = _startHour + snapped ~/ 60;
    final newMin = snapped % 60;
    final newStart = DateTime(_selectedDate.year, _selectedDate.month,
        _selectedDate.day, newHour, newMin);
    final newEnd = newStart.add(entry.duration);

    // X → waiter column
    int? newWaiterId = entry.waiterId;
    final xInColumns = local.dx - _timeColWidth;
    if (xInColumns >= 0 && _waiterIds.isNotEmpty) {
      final colIdx = (xInColumns / _cachedColWidth)
          .floor()
          .clamp(0, _waiterIds.length - 1);
      newWaiterId = _waiterIds[colIdx];
    }

    final db = ref.read(databaseProvider);
    await (db.update(db.orderProducts)
          ..where((t) => t.id.equals(entry.orderProductId)))
        .write(OrderProductsCompanion(
      planStartAt: Value(newStart),
      planEndAt: Value(newEnd),
      planWaiterId: Value(newWaiterId),
      updatedAt: Value(DateTime.now()),
    ));

    ref.invalidate(agendaEntriesProvider(_selectedDate));

    if (mounted) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
              '${entry.productName} moved to ${DateFormat.Hm().format(newStart)}'),
          duration: const Duration(seconds: 2),
        ),
      );
    }
  }

  // ── Detail / edit dialogs ────────────────────────────────────────────────

  void _showEntryDetail(BuildContext context, AgendaEntry e) {
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        shape:
            RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
        titlePadding: EdgeInsets.zero,
        title: Container(
          padding:
              const EdgeInsets.symmetric(horizontal: 20, vertical: 16),
          decoration: BoxDecoration(
            color: e.color.withValues(alpha: 0.85),
            borderRadius:
                const BorderRadius.vertical(top: Radius.circular(16)),
          ),
          child: Row(
            children: [
              const Icon(Icons.event, color: Colors.white),
              const SizedBox(width: 10),
              Expanded(
                child: Text(
                  e.productName,
                  style: const TextStyle(
                      color: Colors.white,
                      fontWeight: FontWeight.bold,
                      fontSize: 16),
                ),
              ),
              _stateChip(e.state),
            ],
          ),
        ),
        content: SingleChildScrollView(
          child: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              _detailRow(Icons.confirmation_number, 'Order', e.orderCode),
              if (e.customerName != null)
                _detailRow(Icons.person, 'Customer', e.customerName!),
              _detailRow(Icons.play_circle_outline, 'Start',
                  DateFormat('dd/MM/yyyy HH:mm').format(e.start)),
              _detailRow(Icons.stop_circle_outlined, 'End',
                  DateFormat('dd/MM/yyyy HH:mm').format(e.end)),
              _detailRow(Icons.timer_outlined, 'Duration',
                  '${e.duration.inMinutes} min'),
              if (e.waiterName != null)
                _detailRow(
                    Icons.person_outline, 'Assigned to', e.waiterName!),
              _detailRow(Icons.info_outline, 'State', e.state),
            ],
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx),
            child: const Text('Close'),
          ),
          ElevatedButton.icon(
            icon: const Icon(Icons.edit, size: 16),
            label: const Text('Edit Time'),
            onPressed: () {
              Navigator.pop(ctx);
              _editEntryTime(context, e);
            },
          ),
        ],
      ),
    );
  }

  Widget _stateChip(String state) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
      decoration: BoxDecoration(
        color: Colors.white.withValues(alpha: 0.25),
        borderRadius: BorderRadius.circular(12),
        border:
            Border.all(color: Colors.white.withValues(alpha: 0.5)),
      ),
      child: Text(state,
          style: const TextStyle(
              color: Colors.white,
              fontSize: 10,
              fontWeight: FontWeight.w600)),
    );
  }

  Widget _detailRow(IconData icon, String label, String value) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 5),
      child: Row(
        children: [
          Icon(icon, size: 17, color: Colors.grey.shade600),
          const SizedBox(width: 10),
          Text('$label: ',
              style: const TextStyle(
                  fontWeight: FontWeight.w600, fontSize: 13)),
          Expanded(
              child: Text(value,
                  overflow: TextOverflow.ellipsis,
                  style: const TextStyle(fontSize: 13))),
        ],
      ),
    );
  }

  Future<void> _editEntryTime(BuildContext context, AgendaEntry e) async {
    DateTime newStart = e.start;
    DateTime newEnd = e.end;

    final startTime = await showTimePicker(
      context: context,
      initialTime: TimeOfDay.fromDateTime(e.start),
      helpText: 'Select new start time',
    );
    if (startTime == null || !context.mounted) return;

    newStart = DateTime(e.start.year, e.start.month, e.start.day,
        startTime.hour, startTime.minute);

    final endTime = await showTimePicker(
      context: context,
      initialTime: TimeOfDay.fromDateTime(e.end),
      helpText: 'Select new end time',
    );
    if (endTime == null || !context.mounted) return;

    newEnd = DateTime(e.end.year, e.end.month, e.end.day,
        endTime.hour, endTime.minute);

    if (newEnd.isBefore(newStart)) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
            content: Text('End time must be after start time')),
      );
      return;
    }

    final db = ref.read(databaseProvider);
    await (db.update(db.orderProducts)
          ..where((t) => t.id.equals(e.orderProductId)))
        .write(OrderProductsCompanion(
      planStartAt: Value(newStart),
      planEndAt: Value(newEnd),
      updatedAt: Value(DateTime.now()),
    ));

    ref.invalidate(agendaEntriesProvider(_selectedDate));
    if (context.mounted) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Booking time updated')),
      );
    }
  }
}

// ────────────────────────────────────────────────────────────────────────────
// Color extension helper
// ────────────────────────────────────────────────────────────────────────────
extension _ColorDarken on Color {
  Color darken(double amount) {
    final hsl = HSLColor.fromColor(this);
    return hsl
        .withLightness((hsl.lightness - amount).clamp(0.0, 1.0))
        .toColor();
  }
}
