{
  "area": "z_rules",
  "about": "Z (business day) rules, contract v3: a Z is a (terminal, zDay, zSeq) label. Times are the shop's wall clock, yyyy-MM-ddTHH:mm:ss with no offset; HH:mm rules are relative to the business day, which starts at startHour. No case crosses a daylight-saving change. Enum values are the Dart names.",
  "dart": "lib/services/z_rules.dart",
  "cases": [
    {
      "name": "before the start hour belongs to the previous day",
      "fn": "zDayKeyOf",
      "input": {
        "now": "2026-11-27T02:30:00",
        "startHour": 5
      },
      "expected": {
        "zDay": "2026-11-26"
      }
    },
    {
      "name": "the start hour opens the new day",
      "fn": "zDayKeyOf",
      "input": {
        "now": "2026-11-27T05:00:00",
        "startHour": 5
      },
      "expected": {
        "zDay": "2026-11-27"
      }
    },
    {
      "name": "one second before the start hour",
      "fn": "zDayKeyOf",
      "input": {
        "now": "2026-11-27T04:59:59",
        "startHour": 5
      },
      "expected": {
        "zDay": "2026-11-26"
      }
    },
    {
      "name": "midnight start",
      "fn": "zDayKeyOf",
      "input": {
        "now": "2026-11-27T23:59:00",
        "startHour": 0
      },
      "expected": {
        "zDay": "2026-11-27"
      }
    },
    {
      "name": "an evening rule is that same night",
      "fn": "ruleInstant",
      "input": {
        "zDay": "2026-11-26",
        "startHour": 5,
        "hhmm": "23:00"
      },
      "expected": {
        "at": "2026-11-26T23:00:00"
      }
    },
    {
      "name": "an early-morning rule is the next calendar morning",
      "fn": "ruleInstant",
      "input": {
        "zDay": "2026-11-26",
        "startHour": 5,
        "hhmm": "02:00"
      },
      "expected": {
        "at": "2026-11-27T02:00:00"
      }
    },
    {
      "name": "a rule at the start hour is the start of the day",
      "fn": "ruleInstant",
      "input": {
        "zDay": "2026-11-26",
        "startHour": 5,
        "hhmm": "05:00"
      },
      "expected": {
        "at": "2026-11-26T05:00:00"
      }
    },
    {
      "name": "a minute before the start hour is the very end of the day",
      "fn": "ruleInstant",
      "input": {
        "zDay": "2026-11-26",
        "startHour": 5,
        "hhmm": "04:59"
      },
      "expected": {
        "at": "2026-11-27T04:59:00"
      }
    },
    {
      "name": "malformed rule is no rule",
      "fn": "ruleInstant",
      "input": {
        "zDay": "2026-11-26",
        "startHour": 5,
        "hhmm": "25:00"
      },
      "expected": {
        "at": null
      }
    },
    {
      "name": "missing rule",
      "fn": "ruleInstant",
      "input": {
        "zDay": "2026-11-26",
        "startHour": 5,
        "hhmm": null
      },
      "expected": {
        "at": null
      }
    },
    {
      "name": "server Z with a datetime zDay",
      "fn": "ZSnapshot.fromServer",
      "input": {
        "json": {
          "zDay": "2026-11-26T00:00:00",
          "zSeq": 2,
          "closed": true
        }
      },
      "expected": {
        "snapshot": {
          "zDay": "2026-11-26",
          "zSeq": 2,
          "closed": true
        }
      }
    },
    {
      "name": "server zSeq sent as a string",
      "fn": "ZSnapshot.fromServer",
      "input": {
        "json": {
          "zDay": "2026-11-26",
          "zSeq": "3"
        }
      },
      "expected": {
        "snapshot": {
          "zDay": "2026-11-26",
          "zSeq": 3,
          "closed": false
        }
      }
    },
    {
      "name": "server zSeq 0 means no Z",
      "fn": "ZSnapshot.fromServer",
      "input": {
        "json": {
          "zDay": "2026-11-26",
          "zSeq": 0,
          "closed": false
        }
      },
      "expected": {
        "snapshot": null
      }
    },
    {
      "name": "terminal that never had a session",
      "fn": "ZSnapshot.fromServer",
      "input": {
        "json": {
          "zDay": null,
          "zSeq": null
        }
      },
      "expected": {
        "snapshot": null
      }
    },
    {
      "name": "today's open Z continues",
      "fn": "planZ",
      "input": {
        "currentZDay": "2026-11-27",
        "localOpen": {
          "zDay": "2026-11-27",
          "zSeq": 1
        },
        "server": {
          "zDay": "2026-11-27",
          "zSeq": 1,
          "closed": false
        }
      },
      "expected": {
        "action": "continueOpen",
        "next": {
          "zDay": "2026-11-27",
          "zSeq": 1
        },
        "closeLocalAsServerClosed": false
      }
    },
    {
      "name": "a Z left open from yesterday continues (never closed by the clock)",
      "fn": "planZ",
      "input": {
        "currentZDay": "2026-11-27",
        "localOpen": {
          "zDay": "2026-11-26",
          "zSeq": 2
        }
      },
      "expected": {
        "action": "continueOpen",
        "next": {
          "zDay": "2026-11-26",
          "zSeq": 2
        },
        "closeLocalAsServerClosed": false
      }
    },
    {
      "name": "the server closed our open Z: close it here, open the next",
      "fn": "planZ",
      "input": {
        "currentZDay": "2026-11-27",
        "localOpen": {
          "zDay": "2026-11-27",
          "zSeq": 1
        },
        "localLatest": {
          "zDay": "2026-11-27",
          "zSeq": 1,
          "closed": false
        },
        "server": {
          "zDay": "2026-11-27",
          "zSeq": 1,
          "closed": true
        }
      },
      "expected": {
        "action": "openNew",
        "next": {
          "zDay": "2026-11-27",
          "zSeq": 2
        },
        "closeLocalAsServerClosed": true
      }
    },
    {
      "name": "the server closed yesterday's Z: today starts at 1",
      "fn": "planZ",
      "input": {
        "currentZDay": "2026-11-27",
        "localOpen": {
          "zDay": "2026-11-26",
          "zSeq": 1
        },
        "server": {
          "zDay": "2026-11-26",
          "zSeq": 1,
          "closed": true
        }
      },
      "expected": {
        "action": "openNew",
        "next": {
          "zDay": "2026-11-27",
          "zSeq": 1
        },
        "closeLocalAsServerClosed": true
      }
    },
    {
      "name": "reinstall mid-day adopts the server's open Z",
      "fn": "planZ",
      "input": {
        "currentZDay": "2026-11-27",
        "localLatest": {
          "zDay": "2026-11-27",
          "zSeq": 1,
          "closed": true
        },
        "server": {
          "zDay": "2026-11-27",
          "zSeq": 2,
          "closed": false
        }
      },
      "expected": {
        "action": "adoptServer",
        "next": {
          "zDay": "2026-11-27",
          "zSeq": 2
        },
        "closeLocalAsServerClosed": false
      }
    },
    {
      "name": "fresh install adopts the server's open Z",
      "fn": "planZ",
      "input": {
        "currentZDay": "2026-11-27",
        "server": {
          "zDay": "2026-11-27",
          "zSeq": 1,
          "closed": false
        }
      },
      "expected": {
        "action": "adoptServer",
        "next": {
          "zDay": "2026-11-27",
          "zSeq": 1
        },
        "closeLocalAsServerClosed": false
      }
    },
    {
      "name": "offline: next sequence from the till's own Zs",
      "fn": "planZ",
      "input": {
        "currentZDay": "2026-11-27",
        "localLatest": {
          "zDay": "2026-11-27",
          "zSeq": 2,
          "closed": true
        }
      },
      "expected": {
        "action": "openNew",
        "next": {
          "zDay": "2026-11-27",
          "zSeq": 3
        },
        "closeLocalAsServerClosed": false
      }
    },
    {
      "name": "first Z ever",
      "fn": "planZ",
      "input": {
        "currentZDay": "2026-11-27"
      },
      "expected": {
        "action": "openNew",
        "next": {
          "zDay": "2026-11-27",
          "zSeq": 1
        },
        "closeLocalAsServerClosed": false
      }
    },
    {
      "name": "a server Z open on an earlier day is not adopted",
