      "expected": {
        "ok": true,
        "problem": null,
        "componentId": null,
        "groupId": null,
        "lines": [
          {
            "componentId": 1,
            "quantity": 1,
            "unitPrice": 0.0
          },
          {
            "componentId": 1,
            "quantity": 2,
            "unitPrice": 1.5
          }
        ],
        "optionTotalPerParentUnit": 3.0
      }
    },
