    {
      "name": "full removal sends a zero row and a charge row",
      "fn": "removals",
      "input": {
        "candidates": [
          {
            "componentId": 1,
            "defaultQuantity": 1,
            "selectedQuantity": 0,
            "unitPrice": 1.5,
            "chargeOnRemoval": true
          }
        ]
      },
      "expected": {
        "rows": [
          {
            "componentId": 1,
            "quantity": 0,
            "price": 0.0,
            "removalCharge": false
          },
          {
            "componentId": 1,
            "quantity": 1,
            "price": 1.5,
            "removalCharge": true
          }
        ],
        "needsExplicitRow": [
          1
        ],
        "chargePerParentUnit": 1.5
      }
    },
