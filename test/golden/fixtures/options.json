{
  "area": "options",
  "about": "Checking and pricing a line's options (what the waiter app sends is checked the way the till's product dialog allows). Maps are keyed by component id as a string; groupOf null = ungrouped. picked is units per parent unit. Checks run in this order: not offered, too many of one, hidden group, then each group's min/max. No refused case has two faults found by the same check, so the order the components are listed in never matters. lines are sorted by componentId then unitPrice; their order carries no meaning.",
  "dart": "lib/domain/models/component_rules.dart (priceOptions, seedGroup, removalRowsFor, removalChargePerParentUnit, maxUnitsOf)",
  "cases": [
    {
      "name": "free allowance covers the most expensive unit",
      "fn": "priceOptions",
      "input": {
        "picked": {
          "1": 2,
          "2": 1,
          "4": 1
        },
        "catalogue": {
          "1": 1.5,
          "2": 2.0,
          "3": 0,
          "4": 0,
          "5": 1.0
        },
        "groupOf": {
          "1": 10,
          "2": 10,
          "3": null,
          "4": 20,
          "5": 20
        },
        "rules": [
          {
            "groupId": 10,
            "selectionType": "QUANTITY",
            "maxSelection": 3,
            "freeQuantity": 1
          },
          {
            "groupId": 20,
            "selectionType": "SINGLE",
            "minSelection": 1,
            "maxSelection": 1
          }
        ]
      },
      "expected": {
        "ok": true,
        "problem": null,
        "componentId": null,
        "groupId": null,
        "lines": [
          {
            "componentId": 1,
            "quantity": 2,
            "unitPrice": 1.5
          },
          {
            "componentId": 2,
            "quantity": 1,
            "unitPrice": 0.0
          },
          {
            "componentId": 4,
            "quantity": 1,
            "unitPrice": 0.0
          }
        ],
        "optionTotalPerParentUnit": 3.0
      }
    },
    {
      "name": "free allowance split across one option's units",
      "fn": "priceOptions",
      "input": {
        "picked": {
          "1": 3
        },
